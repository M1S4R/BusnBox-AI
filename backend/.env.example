APP_NAME=BusNBox AI Backend
APP_VERSION=0.1.0

HOST=127.0.0.1
PORT=8000
DEBUG=true

CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://127.0.0.1:3000"]

# Service-to-service Authentication (Optional: leave empty for private local/network integration)
BUSNBOX_API_KEY=
BUSNBOX_API_KEY_HEADER=X-BusNBox-Key
REQUEST_TIMEOUT_SECONDS=30

# Inventory Provider: 'mock' (in-memory, no external service needed) or 'company' (REST HTTP adapter)
INVENTORY_PROVIDER=mock
INVENTORY_API_BASE_URL=http://127.0.0.1:9000
INVENTORY_API_SEARCH_PATH=/api/inventory/search
INVENTORY_API_KEY=
INVENTORY_API_KEY_HEADER=X-API-Key
INVENTORY_API_TIMEOUT_SECONDS=15
INVENTORY_API_CONNECT_TIMEOUT_SECONDS=5

# AI Provider: 'gemini' or 'ollama'
AI_PROVIDER=gemini

# Gemini Configuration (Keep server-side only; never expose to browser)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_SECONDS=30

# Database Configuration (Optional: only needed if running local mock company API)
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_NAME=busnbox
DATABASE_USER=busnbox_user
DATABASE_PASSWORD=

# Ollama Fallback (Optional)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b

